Property
{
	MalterlibMemoryManager_OverrideDll: bool = false
}

%Target "Malterlib_Memory_MalterlibMalloc"
{
	Property
	{
		ProductName "Malterlib Malloc"
		MalterlibPostCopyProject "MalterlibMalloc"
		{
			!!MalterlibPostCopyProject undefined
		}
	}
	Target
	{
		FileName "MalterlibMalloc"
		Type "SharedDynamicLibrary"
		GenerateScheme true
		LinkWithLibraries += [["-install_name", "@rpath/MalterlibMalloc.dylib"]]
		{
			!!PlatformFamily "macOS"
		}
		// Weak, and missing from newer macOS SDKs: it binds to null where the system doesn't have it, and dyld then skips its
		// interpose.
		LinkWithLibraries += [["-Wl,-U,_malloc_type_zone_malloc_with_options_np"]]
		{
			!!PlatformFamily "macOS"
		}
	}
	%Group "Source"
	{
		%File "Source/*"
		%File "../../Source/Malterlib_Memory_SystemOverride_MacOSLibSystem.cpp"
		{
			&
			{
				MalterlibMemoryManager_OverrideDll true
				PlatformFamily "macOS"
			}
		}
	}
	%Dependency "Lib_Malterlib"
}

%Workspace "Malterlib_Memory_Malloc"
{
	&
	{
		MalterlibEnableInternalWorkspaces true
	}

	Property
	{
		MalterlibMemoryManager_OverrideDll true
		MalterlibLog_Severities []
	}

	Compile
	{
		!!CompileDialect "C"
		PreprocessorDefines =+ "DMibMemoryOverrideDll"
	}

	%Target "Malterlib_Memory_MalterlibMalloc"
}

%Workspace "Malterlib_Memory_MallocDummy"
{
	&
	{
		MalterlibEnableInternalWorkspaces true
	}

	%Target "Malterlib_Memory_MalterlibMalloc"
	{
		Property.MalterlibPostCopyProject "MalterlibMallocDummy"
	}
}
