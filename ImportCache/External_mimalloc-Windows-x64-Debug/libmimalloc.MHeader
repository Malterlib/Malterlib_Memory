Property.CMakeOutputPath_libmimalloc: string = `@('.'->MakeAbsolute())`->MakeAbsolute()
%Target "Lib_libmimalloc_mimalloc-static"
{
	Compile
	{
		!!Compile.Type "C++"
		SearchPath += [
			`@('../../../../External/mimalloc'->MakeAbsolute())/include`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"MI_CMAKE_BUILD_TYPE=debug",
			"MI_DEBUG=2",
			"MI_GUARDED=2",
			"MI_PROFILE=2",
			"MI_STATIC_LIB",
			"MI_STATS=0",
			"WIN32",
			"_WINDOWS"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/libmimalloc"
	{
		!!Target.Group undefined
	}
	Target.Type "StaticLibrary"
	Target.BaseName "libmimalloc_mimalloc-static"
	Target.BaseFileName "mimalloc-static"
	%Group "src"
	{
		%Group "prim"
		{
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/prim/os.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/prim/prim.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/prim/prim-tls.c`
			{
				Compile.Type "C++"
			}
		}
		%Group "util"
		{
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/util/libc.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/util/memid.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/util/options.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/util/random.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/util/stats.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/util/threadlocal.c`
			{
				Compile.Type "C++"
			}
		}
		%Group "arena"
		{
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/arena/arena.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/arena/arena-alloc.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/arena/arena-page.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/arena/arena-page-alloc.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/arena/arena-heap.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/arena/bitmap.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/arena/bitmap-chunk.c`
			{
				Compile.Type "C++"
			}
		}
		%Group "alloc"
		{
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/alloc/alloc.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/alloc/alloc-generic.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/alloc/alloc-aligned.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/alloc/alloc-posix.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/alloc/page.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/alloc/page-queue.c`
			{
				Compile.Type "C++"
			}
		}
		%Group "heap"
		{
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/heap/heap.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/heap/process.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/heap/page-map.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/heap/subproc.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/heap/theap.c`
			{
				Compile.Type "C++"
			}
		}
		%Group "profile"
		{
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/profile/sample-guarded.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/profile/sample-profile.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/profile/pprof.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/profile/pprof-os.c`
			{
				Compile.Type "C++"
			}
			%File `@('../../../../External/mimalloc'->MakeAbsolute())/src/profile/pprof-write.c`
			{
				Compile.Type "C++"
			}
		}
	}
}
