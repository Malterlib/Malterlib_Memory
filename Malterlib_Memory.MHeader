Import "../Core/Malterlib_Core.MHeader"
Import "../Core/Lib_Malterlib.MTarget"
Import "Apps/*/*.MHeader"

%Repository "mimalloc"
{
	|
	{
		MalterlibMemoryManager "MiMalloc"
		MalterlibEnableThirdPartyComparisonTests true
	}

	Repository
	{
		Type "External"
		DefaultUpstreamBranch "main"
		Remotes =+ {Name: "upstream", URL: "https://github.com/microsoft/mimalloc.git"}
	}
}

%Repository "gperftools"
{
	|
	{
		MalterlibMemoryManager "TcMalloc"
		MalterlibEnableThirdPartyComparisonTests true
	}

	Repository
	{
		Type "External"
		Remotes =+ {Name: "upstream", URL: "https://github.com/gperftools/gperftools.git"}
	}
}

%Group "{Malterlib}/{TCMalloc}"
{
	Compile
	{
		&
		{
			CompileDialect "C"
		}

		SearchPath += "../../External/gperftools/src"->MakeAbsolute()
		SearchPath += "../../External/gperftools/src/windows"->MakeAbsolute()
		{
			!!PlatformFamily "Windows"
		}
		SearchPath += "Source/TCMalloc/Shared"->MakeAbsolute()
		SearchPath += `@("Source/TCMalloc"->MakeAbsolute())/@(PlatformFamily)/@(Architecture)`
		PreprocessorDefines += ["TCMALLOC_NO_REPLACE_SYSTEM_MALLOC", "HAVE_TLS"]
	}
	%Group "TcMalloc"
	{
		!!MalterlibEnableThirdPartyComparisonTests true
		%File "Source/TCMalloc/^*"
		%Group "External"
		{
			Property
			{
				ExcludeFiles =+ "*/tests/*"
				ExcludeFiles =+ "*/solaris/*"
				ExcludeFiles =+ "*/nm-pdb.c"
				ExcludeFiles =+ "*/preamble_patcher_test.cc"
				ExcludeFiles =+ "*/addr2line-pdb.c"
			}
			%Group "Source"
			{
				Compile
				{
					!!MalterlibCompileSupportTabSetings true
					IndentWidth 2
					TabWidth 2
					UsesTabs false
				}

				%File "../../External/gperftools/src/^*.h"
				%File "../../External/gperftools/src/^*.cc"
				%File "../../External/gperftools/src/debugallocation.cc"
				{
					Compile.Disabled true
				}
				%File "../../External/gperftools/src/heap-profiler.cc"
				{
					Compile.Disabled true
				}
				%File "../../External/gperftools/src/system-alloc.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/profiledata.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/profile-handler.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/heap-profile-table.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/profiler.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/emergency_malloc.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/emergency_malloc_for_stacktrace.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/heap-checker.cc"
				{
					Compile.Disabled true
					{
						!PlatformFamily "Linux"
					}
				}
				%File "../../External/gperftools/src/heap-checker-bcad.cc"
				{
					Compile.Disabled true
				}
				%Group "base"
				{
					%File "../../External/gperftools/src/base/linuxthreads.cc"
					{
						Compile.Disabled true
					}
				}
				%Group "windows"
				{
					Compile.Disabled true
					{
						!PlatformFamily "Windows"
					}
					%File "../../External/gperftools/src/windows/override_functions.cc"
					{
						Compile.Disabled true
					}
					%File "../../External/gperftools/src/windows/patch_functions.cc"
					{
						Compile.Disabled true
					}
					%File "../../External/gperftools/src/windows/get_mangled_names.cc"
					{
						Compile.Disabled true
					}
				}
			}
		}
	}
}

%Import "../../External/mimalloc/CMakeLists.txt"
{
	|
	{
		MalterlibMemoryManager "MiMalloc"
		MalterlibEnableThirdPartyComparisonTests true
	}

	Import.CMake_FullRebuildVersion `@(Import.CMake_FullRebuildVersion).1`
	Import.CMake_Variables += [
		"MI_OVERRIDE=OFF"
		, "MI_USE_CXX=ON"
		, "MI_PADDING=OFF"
		, "MI_BUILD_SHARED=OFF"
		, "MI_BUILD_OBJECT=OFF"
	]

	Import.CMake_Variables += "CMAKE_BUILD_WITH_INSTALL_RPATH=ON"
	{
		&
		{
			PlatformFamily "Linux"
			!HostPlatformFamily "Linux"
		}
	}
	Compile
	{
		!!MalterlibCompileSupportTabSetings true
		IndentWidth 2
		TabWidth 2
		UsesTabs false
	}
	Compile
	{
		!!CompileDialect "C"
		Analyzer false

		PreprocessorDefines += ["MI_STAT=0", "MI_PADDING=0", "MI_SECURE=0", "MI_MALLOC_OVERRIDE_TLS_SUPPORT=1", "MI_USE_RTLGENRANDOM=1"]
	}
	%Target "Lib_libmimalloc_mimalloc-static"
	{
		%Group "include"
		{
			%File "../../External/mimalloc/include/^*"
		}
	}
}

%Group "{Malterlib}/{Lib_Malterlib_Memory}"
{
	Property.ExcludeFiles =+ "*.aps"

	%Group "Memory"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Memory/^*"
		}
		%Group "Platform"
		{
			%File "Source/Platform/*"
			{
				Compile.Disabled true
				{
					!PlatformFamily PlatformFamilyFromFile
				}
			}
		}
		%File "Source/*"
		%File "Source/Malterlib_Memory_SystemManager*"
		{
			Compile.Disabled true
		}
		%File "Source/Malterlib_Memory_SystemOverride*"
		{
			Compile.Disabled true
		}
		%File "Source/Malterlib_Memory_Allocator_Heap.cpp"
		{
			Compile.Disabled true
		}
		%File "Source/Malterlib_Memory.cpp"
		{
			Compile.Disabled true
		}
		%File "Source/Malterlib_Memory_Reporter_Categories.rc"
		{
			Compile.Disabled true
			{
				|
				{
					!MalterlibMemory_Shims_Enable true
					!MalterlibMemoryManager_Stats_EnableCategories true
					!PlatformFamily "Windows"
				}
			}
		}
		%Group "Mig"
		{
			&
			{
				PlatformFamily "macOS"
				MalterlibMemoryManager_EnableOverrideSystemMalloc true
			}
			%File "Source/Mig/*"
		}
		%Group "Documentation"
		{
			%File "Documentation/*"
			%File "Documentation/*.md"
			{
				Compile.Type "C++"
				{
					!!DocumentationEnabled true
				}
			}
			%File "Documentation/*.svg"
			{
				Compile.Type "C++"
				{
					!!DocumentationEnabled true
				}
			}
		}
	}
}

Property
{
	MalterlibLibrary_Memory: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Memory"
	{
		!!MalterlibLibrary_Memory true
	}
	//MalterlibSubLibrarySeparate_Lib_Malterlib_Memory: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Memory true
	}

	MalterlibTestsMem_EnablePerfTests: bool = true // User(Tests)=false: Enable performance memory tests (default true)
}

%Target "Dll_Test_Malterlib_Helper_Memory"
{
	Property
	{
		MalterlibHelperTest true
		MalterlibPostCopyProject "Tests"
		ProductName "Malterlib Test Memory Dll"
	}
	Target
	{
		BaseName "Test_Malterlib_Helper_Memory"
		Type "DynamicLibrary"
		Group "Helpers"
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader undefined
	}
	%File "Test/Test_Malterlib_Memory_DllMain.cpp"
	%Dependency "Lib_Malterlib"
}


%Group "{Test}/{Malterlib_Memory}"
{
	Property
	{
		MalterlibWindowsNtVersion "_WIN32_WINNT_VISTA"
		MalterlibWindowsVersion "NTDDI_VISTA"

		MemoryManagerTestEnable_Malterlib: bool = true
		MemoryManagerTestEnable_MacOS: bool = PlatformFamily == "macOS"

		MemoryManagerTestEnable_Application: bool = true
		MemoryManagerTestEnable_StdLib: bool = true
		MemoryManagerTestEnable_Virtual: bool = false

		MemoryManagerTestEnable_WindowsDefault: bool = false

		MemoryManagerTestEnable_WindowsLF: bool = PlatformFamily == "Windows"

		//MalterlibWindowsSettings_SegmentHeap true

		MemoryManagerTestEnable_TcMalloc: bool = false
		/* Problematic, overrides global functions
		MemoryManagerTestEnable_TcMalloc true
		{
			&
			{
				MemoryManagerTestEnable_TcMalloc undefined
				MalterlibEnableThirdPartyComparisonTests true
				Architecture "x64"
				!MalterlibSupportSanitizers true
			}
		}
		 */

		MemoryManagerTestEnable_MiMalloc: bool = false
		MemoryManagerTestEnable_MiMalloc true
		{
			&
			{
				MemoryManagerTestEnable_MiMalloc undefined
				MalterlibEnableThirdPartyComparisonTests true
				|
				{
					!Architecture "x86"
					PlatformFamily "Windows"
				}
			}
		}
	}
	Target
	{
		ExtraGroups += "{Malterlib}/{TCMalloc}"
		{
			!!MemoryManagerTestEnable_TcMalloc true
		}
	}
	Compile
	{
		&
		{
			CompileDialect "C"
			MalterlibEnableThirdPartyComparisonTests true
		}
		SearchPath += "../../External/mimalloc/include"->MakeAbsolute()
	}
	Compile
	{
		!!CompileDialect "C"

		SearchPath += ".."->MakeAbsolute()

		Warnings_DeprecatedDeclarations false
		{
			!!Compiler "Clang"
		}

		PreprocessorDefines += "PERFTOOLS_DLL_DECL="
		PreprocessorDefines += "DMemoryManagerTestEnable_MacOS"
		{
			!!MemoryManagerTestEnable_MacOS true
		}
		PreprocessorDefines += "DMemoryManagerTestEnable_Malterlib"
		{
			!!MemoryManagerTestEnable_Malterlib true
		}
		PreprocessorDefines += "DMemoryManagerTestEnable_StdLib"
		{
			!!MemoryManagerTestEnable_StdLib true
		}
		PreprocessorDefines += "DMemoryManagerTestEnable_Application"
		{
			!!MemoryManagerTestEnable_Application true
		}
		PreprocessorDefines += "DMemoryManagerTestEnable_Virtual"
		{
			!!MemoryManagerTestEnable_Virtual true
		}
		PreprocessorDefines += "DMemoryManagerTestEnable_WindowsDefault"
		{
			!!MemoryManagerTestEnable_WindowsDefault true
		}
		PreprocessorDefines += "DMemoryManagerTestEnable_WindowsLF"
		{
			!!MemoryManagerTestEnable_WindowsLF true
		}
		PreprocessorDefines += "DMemoryManagerTestEnable_TcMalloc"
		{
			!!MemoryManagerTestEnable_TcMalloc true
		}
		PreprocessorDefines += "DMemoryManagerTestEnable_MiMalloc"
		{
			!!MemoryManagerTestEnable_MiMalloc true
		}
		PreprocessorDefines += "DMibConfig_OverrideSystemMalloc"
		{
			!!MalterlibMemoryManager_EnableOverrideSystemMalloc true
		}
		PreprocessorDefines += `DMibConfig_MemoryManager_Use@(MalterlibMemoryManager)`
	}
	%Group "Documentation"
	{
		%File "Documentation/MemoryManager.md"
		%File "Documentation/MemoryManagerSlabs.md"
		%File "../Core/Documentation/Markdown.css"
	}
	%Group "Tests"
	{
		%File "Test/*"
		%File "Test/Test_Malterlib_Memory_DllMain.cpp"
		{
			Compile.Disabled true
		}
		%File "Test/Test_Malterlib_Memory_MemoryManager_Performance.cpp"
		{
			Compile.Disabled true
			{
				!!MalterlibTestsMem_EnablePerfTests false
			}
		}
	}

	%Dependency "Lib_Malterlib"
	%Dependency "Dll_Test_Malterlib_Helper_Memory"
	{
		Dependency.Link false
		Dependency.Stage "Runtime"
	}
	%Dependency "Lib_libmimalloc_mimalloc-static"
	{
		!!MemoryManagerTestEnable_MiMalloc true
	}
}

Property
{
	!!MalterlibEnableInternalTests true

	MalterlibTests =+ "Malterlib_Memory"
	MalterlibTestExtraGroups_Malterlib_Memory: [string] = ["{Test}/{Malterlib_Memory}"]
}

Property.Malterlib_Memory_App_Targets: [type(CEntity)] = []

%Workspace "Apps_Malterlib_Memory"
{
	&
	{
		MalterlibEnableInternalWorkspaces true
	}

	%Target Malterlib_Memory_App_Targets
}
