Import "../Core/Lib_Malterlib.MTarget"
Import "Apps/*/*.MHeader"

%Repository "mimalloc"
{
	|
	{
		MalterlibMemoryManager "MiMalloc"
		MalterlibEnableThirdPartyComparisonTests true
	}

	Repository
	{
		Type "External"
		Remotes "upstream=https://github.com/microsoft/mimalloc.git;@(Repository.Remotes)"
	}
}

%Repository "gperftools"
{
	|
	{
		MalterlibMemoryManager "TcMalloc"
		MalterlibEnableThirdPartyComparisonTests true
	}

	Repository
	{
		Type "External"
		Remotes "upstream=https://github.com/gperftools/gperftools.git;@(Repository.Remotes)"
	}
}

%Group "{Malterlib}/{TCMalloc}"
{
	Compile
	{
		&
		{
			CompileDialect "C"
		}

		SearchPath "@('../../External/gperftools/src'->MakeAbsolute());@(Compile.SearchPath)"
		SearchPath "@('../../External/gperftools/src/windows'->MakeAbsolute());@(Compile.SearchPath)"
		{
			!!PlatformFamily "Windows"
		}
		SearchPath "@('Source/TCMalloc'->MakeAbsolute())/@(PlatformFamily)/@(Architecture);@(Compile.SearchPath)"
		SearchPath "@('Source/TCMalloc/Shared'->MakeAbsolute());@(Compile.SearchPath)"
		PreprocessorDefines "TCMALLOC_NO_REPLACE_SYSTEM_MALLOC;@(Compile.PreprocessorDefines)"
	}
	%Group "TcMalloc"
	{
		!!MalterlibEnableThirdPartyComparisonTests true
		%File "Source/TCMalloc/^*"
		%Group "External"
		{
			Property
			{
				ExcludeFiles "*/tests/*;@(ExcludeFiles)"
				ExcludeFiles "*/solaris/*;@(ExcludeFiles)"
				ExcludeFiles "*/nm-pdb.c;@(ExcludeFiles)"
				ExcludeFiles "*/preamble_patcher_test.cc;@(ExcludeFiles)"
				ExcludeFiles "*/addr2line-pdb.c;@(ExcludeFiles)"
			}
			%Group "Source"
			{
				Compile
				{
					!!MalterlibCompileSupportTabSetings true
					IndentWidth 2
					TabWidth 2
					UsesTabs false
				}
				Compile.Disabled true
				{
					!MemoryManagerTestEnable_TcMalloc true
				}

				!!MalterlibEnableThirdPartyComparisonTests true
				%File "../../External/gperftools/src/^*.h"
				%File "../../External/gperftools/src/^*.c"
				%File "../../External/gperftools/src/^*.cc"
				%File "../../External/gperftools/src/debugallocation.cc"
				{
					Compile.Disabled true
				}
				%File "../../External/gperftools/src/heap-profiler.cc"
				{
					Compile.Disabled true
				}
				%File "../../External/gperftools/src/system-alloc.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/profiledata.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/profile-handler.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/heap-profile-table.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/profiler.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/maybe_threads.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/emergency_malloc.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/emergency_malloc_for_stacktrace.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/heap-checker.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%File "../../External/gperftools/src/heap-checker-bcad.cc"
				{
					Compile.Disabled true
					{
						!!PlatformFamily "Windows"
					}
				}
				%Group "base"
				{
					%File "../../External/gperftools/src/base/thread_lister.c"
					{
						Compile.Disabled true
						{
							!!PlatformFamily "Windows"
						}
					}
				}
				%Group "windows"
				{
					Compile.Disabled true
					{
						!PlatformFamily "Windows"
					}
					%File "../../External/gperftools/src/windows/override_functions.cc"
					{
						Compile.Disabled true
					}
					%File "../../External/gperftools/src/windows/patch_functions.cc"
					{
						Compile.Disabled true
					}
 					%File "../../External/gperftools/src/windows/get_mangled_names.cc"
					{
						Compile.Disabled true
					}
				}
			}
		}
	}
}

%Import "../../External/mimalloc/CMakeLists.txt"
{
	|
	{
		MalterlibMemoryManager "MiMalloc"
		MalterlibEnableThirdPartyComparisonTests true
	}

	Import.CMake_FullRebuildVersion "@(Import.CMake_FullRebuildVersion).1"
	Import.CMake_Variables "MI_OVERRIDE=OFF;@(Import.CMake_Variables)"
	Import.CMake_Variables "MI_USE_CXX=ON;@(Import.CMake_Variables)"
	Import.CMake_Variables "MI_PADDING=OFF;@(Import.CMake_Variables)"
	Import.CMake_Variables "MI_BUILD_SHARED=OFF;@(Import.CMake_Variables)"
	Import.CMake_Variables "MI_BUILD_OBJECT=OFF;@(Import.CMake_Variables)"
	Import.CMake_Variables "CMAKE_BUILD_WITH_INSTALL_RPATH=ON;@(Import.CMake_Variables)"
	{
		&
		{
			PlatformFamily "Linux"
			!HostPlatformFamily "Linux"
		}
	}
	Compile
	{
		!!MalterlibCompileSupportTabSetings true
		IndentWidth 2
		TabWidth 2
		UsesTabs false
	}
	Compile
	{
		!!CompileDialect "C"

		PreprocessorDefines "MI_STAT=0;MI_PADDING=0;@(Compile.PreprocessorDefines)"
	}
	%Target "Lib_mimalloc-static"
	{
		%Group "include"
		{
			%File "../../External/mimalloc/include/^*"
		}
	}
}

%Group "{Malterlib}/{Lib_Malterlib_Memory}"
{
	%Group "Memory"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Memory/^*"
		}
		%File "Source/*"
		%File "Source/Malterlib_Memory_SystemManager*"
		{
			Compile.Disabled true
		}
		%File "Source/Malterlib_Memory_SystemOverride*"
		{
			Compile.Disabled true
		}
		%File "Source/Malterlib_Memory_Allocator_Heap.cpp"
		{
			Compile.Disabled true
		}
		%File "Source/Malterlib_Memory.cpp"
		{
			Compile.Disabled true
		}
		%Group "Documentation"
		{
			%File "Documentation/*"
			%File "Documentation/*.md"
			{
				Compile.Type "C++"
				{
					!!DocumentationEnabled true
				}
			}
			%File "Documentation/*.svg"
			{
				Compile.Type "C++"
				{
					!!DocumentationEnabled true
				}
			}
		}
	}
}

Property
{
	MalterlibLibrary_Memory true
	{
		&
		{
			MalterlibLibrary_Memory ""
			MalterlibLibrary_All true
		}
	}
	MalterlibSubLibraries "Memory;@(MalterlibSubLibraries)"
	{
		!!MalterlibLibrary_Memory true
	}
	//MalterlibSubLibrarySeparate_Lib_Malterlib_Memory true
	MalterlibIncludeRoots "@('Include'->MakeAbsolute());@(MalterlibIncludeRoots)"
	{
		!!MalterlibLibrary_Memory true
	}
}

%Target "Dll_Test_Malterlib_Helper_Memory"
{
	Property
	{
		MalterlibHelperTest true
		MalterlibPostCopyProject "Tests"
		ProductName "Malterlib Test Memory Dll"
	}
	Target
	{
		BaseName "Test_Malterlib_Helper_Memory"
		Type "DynamicLibrary"
		Group "Helpers"
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader ""
	}
	%File "Test/Test_Malterlib_Memory_DllMain.cpp"
	%Dependency "Lib_Malterlib"
}


%Group "{Test}/{Malterlib_Memory}"
{
	Property
	{
		MalterlibWindowsNtVersion "_WIN32_WINNT_VISTA"
		MalterlibWindowsVersion "NTDDI_VISTA"

		MemoryManagerTestEnable_Malterlib true
		MemoryManagerTestEnable_OSX true
		{
			!!PlatformFamily "OSX"
		}
		MemoryManagerTestEnable_Application true
		MemoryManagerTestEnable_StdLib true
//			MemoryManagerTestEnable_Virtual true
		MemoryManagerTestEnable_WindowsDefault true
		{
			!!PlatformFamily "Windows"
		}
		MemoryManagerTestEnable_WindowsLF true
		{
			!!PlatformFamily "Windows"
		}
		MemoryManagerTestEnable_TcMalloc true
		{
			&
			{
				MalterlibEnableThirdPartyComparisonTests true
				Architecture "x64"
				!MalterlibSupportSanitizers true
			}
		}
		MemoryManagerTestEnable_MiMalloc true
		{
			&
			{
				MalterlibEnableThirdPartyComparisonTests true
				|
				{
					!Architecture x86
					PlatformFamily Windows
				}
			}
		}
	}
	Target
	{
		LinkWithLibraries	"kernel32.lib;@(Target.LinkWithLibraries)"
		{
			!!PlatformType "Windows"
		}
		ExtraGroups "{Malterlib}/{TCMalloc};@(Target.ExtraGroups)"
		{
			!!MalterlibEnableThirdPartyComparisonTests true
		}
	}
	Compile
	{
		&
		{
			CompileDialect "C"
			MalterlibEnableThirdPartyComparisonTests true
		}
		SearchPath "@('../../External/mimalloc/include'->MakeAbsolute());@(Compile.SearchPath)"
	}
	Compile
	{
		!!CompileDialect "C"

		SearchPath "@('..'->MakeAbsolute());@(Compile.SearchPath)"

		Warnings_DeprecatedDeclarations false
		{
			!!GeneratorFamily "Xcode"
		}

		PreprocessorDefines "PERFTOOLS_DLL_DECL=;@(Compile.PreprocessorDefines)"
		PreprocessorDefines "DMemoryManagerTestEnable_OSX;@(Compile.PreprocessorDefines)"
		{
			!!MemoryManagerTestEnable_OSX true
		}
		PreprocessorDefines "DMemoryManagerTestEnable_Malterlib;@(Compile.PreprocessorDefines)"
		{
			!!MemoryManagerTestEnable_Malterlib true
		}
		PreprocessorDefines "DMemoryManagerTestEnable_StdLib;@(Compile.PreprocessorDefines)"
		{
			!!MemoryManagerTestEnable_StdLib true
		}
		PreprocessorDefines "DMemoryManagerTestEnable_Application;@(Compile.PreprocessorDefines)"
		{
			!!MemoryManagerTestEnable_Application true
		}
		PreprocessorDefines "DMemoryManagerTestEnable_Virtual;@(Compile.PreprocessorDefines)"
		{
			!!MemoryManagerTestEnable_Virtual true
		}
		PreprocessorDefines "DMemoryManagerTestEnable_WindowsDefault;@(Compile.PreprocessorDefines)"
		{
			!!MemoryManagerTestEnable_WindowsDefault true
		}
		PreprocessorDefines "DMemoryManagerTestEnable_WindowsLF;@(Compile.PreprocessorDefines)"
		{
			!!MemoryManagerTestEnable_WindowsLF true
		}
		PreprocessorDefines "DMemoryManagerTestEnable_TcMalloc;@(Compile.PreprocessorDefines)"
		{
			!!MemoryManagerTestEnable_TcMalloc true
		}
		PreprocessorDefines "DMemoryManagerTestEnable_MiMalloc;@(Compile.PreprocessorDefines)"
		{
			!!MemoryManagerTestEnable_MiMalloc true
		}
		PreprocessorDefines "DMibConfig_OverrideSystemMalloc;@(Compile.PreprocessorDefines)"
		{
			!!MalterlibMemoryManager_EnableOverrideSystemMalloc true
		}
		PreprocessorDefines "DMibConfig_MemoryManager_Use@(MalterlibMemoryManager);@(Compile.PreprocessorDefines)"
	}
	%Group "Documentation"
	{
		%File "Documentation/MemoryManager.md"
		%File "Documentation/MemoryManagerSlabs.md"
		%File "../Core/Documentation/Markdown.css"
	}
	%Group "Tests"
	{
		%Group "Performance" 
		{
			Compile.Disabled true
			{
				!!MalterlibTestsMem_EnablePerfTests false
			}
			%File "Test/Test_Malterlib_Memory_MemoryManager_Performance.h"
			%File "Test/Test_Malterlib_Memory_MemoryManager_Performance.cpp"
		}

		%File "Test/Test_Malterlib_Memory_DebugMemoryManager.cpp"
		%File "Test/Test_Malterlib_Memory_MemoryManager_Basics.cpp"
		%File "Test/Test_Malterlib_Memory_MemoryManager_Debug.cpp"
		%File "Test/Test_Malterlib_Memory_Pool.cpp"
	}
	%Dependency "Lib_Malterlib"
	%Dependency "Dll_Test_Malterlib_Helper_Memory"
	{
		Dependency.Link false
	}
	%Dependency "Lib_mimalloc-static"
	{
		!!MemoryManagerTestEnable_MiMalloc true
	}
}


Property
{
	!!MalterlibEnableInternalTests true

	MalterlibTests "Malterlib_Memory;@(MalterlibTests)"
	MalterlibTestExtraGroups_Malterlib_Memory "{Test}/{Malterlib_Memory}"
}

%Workspace "Apps_Malterlib_Memory"
{
	&
	{
		MalterlibEnableInternalWorkspaces true
	}

	%Target "@(Malterlib_Memory_App_Targets)"
}
